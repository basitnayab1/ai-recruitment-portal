# =============================================================================
# AI Recruitment Portal — Environment Variables (placeholders only)
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# --- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key

# --- Public site URL (auth email redirects, sitemap, Open Graph) ------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- App branding (optional) ------------------------------------------------
APP_NAME=AI Recruitment Portal

# --- Groq AI (required for Copilot, resume analysis, ranking, email AI) -----
GROQ_API_KEY=your_groq_api_key
# Optional model overrides
# GROQ_LIGHTWEIGHT_MODEL=llama-3.1-8b-instant
# GROQ_PLANNER_MODEL=llama-3.1-8b-instant

# --- Resend email (required for outbound notifications) ---------------------
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=AI Recruitment Portal
HR_NOTIFICATION_EMAIL=hr@your-domain.com

# --- Debug (optional) -------------------------------------------------------
# COPILOT_DEBUG=0
